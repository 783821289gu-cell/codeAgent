# Required for all runs. PostgreSQL must have the vector extension.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/DATABASE
REPOPILOT_PGVECTOR_SCHEMA=repopilot

# Required for autonomous OpenAI runs; compatible providers can use the settings below instead.
OPENAI_API_KEY=
REPOPILOT_MODEL=gpt-5.6-terra
REPOPILOT_LLM_BASE_URL=
REPOPILOT_LLM_API_KEY=

# Local BGE retrieval defaults.
REPOPILOT_EMBEDDING_PROVIDER=bge
REPOPILOT_EMBEDDING_MODEL=BAAI/bge-m3
REPOPILOT_EMBEDDING_DIMENSIONS=1024
REPOPILOT_RERANKER_MODEL=BAAI/bge-reranker-base

# Optional runtime overrides.
REPOPILOT_MAX_TURNS=30
REPOPILOT_SHELL_TIMEOUT_SECONDS=120
REPOPILOT_MAX_TOOL_OUTPUT_TOKENS=3000
REPOPILOT_CONTEXT_BUDGET_TOKENS=12000
REPOPILOT_COMPACTION_THRESHOLD_TOKENS=9000
REPOPILOT_RAG_TOP_K=8

# Optional external GitHub MCP server.
REPOPILOT_GITHUB_MCP_URL=
REPOPILOT_GITHUB_TOKEN=
